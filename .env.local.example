# NVIDIA NIM API Authentication Key
# Get your API key from NVIDIA NIM dashboard (https://build.nvidia.com/)
NVIDIA_NIM_API_KEY=YOUR_NVIDIA_NIM_API_KEY

# Optional: Vision model override (defaults to meta/llama-3.2-11b-vision-instruct)
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional: Custom NVIDIA NIM API endpoint URL
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
